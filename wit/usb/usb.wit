/// eo9:usb — a USB host capability at the device level: root-hub port status, device
/// attachment (reset + address + descriptor head), control transfers, interrupt-IN
/// endpoints, and bulk endpoints.
///
/// This is what a USB *host controller driver* exports and what USB-aware programs
/// import (docs/board/usb-ohci-plan.md §2): the controller shells (`usb.ohci` over
/// eo9:platform on the board, `usb.ohci-pci` over eo9:pci under QEMU's `-device
/// pci-ohci`) own the register/schedule conversation, and the consumer (`usbcheck`,
/// `hidcheck`, eventually the HID-to-console service) speaks setup packets and
/// descriptors — the same split eo9:net draws between the NIC driver and the l2
/// consumer. The interface is deliberately transfer-shaped, not class-shaped: HID,
/// hubs, mass storage, and everything else are the consumer's business.
///
/// v1 scope was what a boot-protocol keyboard/mouse needs — control transfers and
/// interrupt-IN polling. Bulk endpoints arrived with their first consumer (`usb.msd`,
/// docs/board/usb-msd-plan.md §1.1): `open-bulk-in`/`open-bulk-out` plus
/// `bulk-read`/`bulk-write`, transfer-shaped like everything else — the Bulk-Only
/// Transport protocol that rides them lives in the consumer. Isochronous endpoints
/// still await theirs.
package eo9:usb@0.1.0;

/// Root-handle type (types-only interface — see plan/02-wit.md Decisions).
interface types {
    /// The USB capability's root handle: one host controller's root hub.
    resource usb-impl;
}

/// The host surface: controller identity, port status, attachment, transfers.
interface usb {
    use types.{usb-impl};

    /// The capability's root handle (see SPEC: The capability algebra).
    default: func() -> usb-impl;

    variant usb-error {
        /// The underlying device capability refused (e.g. the shell composed over
        /// `platform.deny` / `pci.deny`, or a boot that did not grant the root).
        denied,
        /// No host controller is visible/claimable through the underlying capability.
        no-controller,
        /// No such port, or the device went away (disconnect mid-conversation).
        not-found,
        /// The controller or device is already claimed/in use.
        busy,
        /// The endpoint answered STALL (request not supported by the device).
        stall,
        /// A bounded wait expired (transfer never completed; enumeration timing).
        timeout,
        /// The provider does not support the request.
        unsupported,
        io(string),
    }

    /// Controller identity, read at bring-up.
    record controller-info {
        /// BCD revision of the host controller interface (OHCI: HcRevision & 0xff,
        /// expect 0x10 for OHCI 1.0).
        revision: u8,
        /// Number of root-hub ports (OHCI: HcRhDescriptorA.NDP).
        ports: u8,
    }

    /// Outcome of one bounded root-hub event wait (`watch-ports`).
    enum watch-outcome {
        /// The controller signalled a root-hub status change (the event path) —
        /// re-read `port` now.
        changed,
        /// The provider's bounded wait window expired with no change signalled.
        /// Re-sweeping costs nothing (the wait already paced the loop); a device
        /// found by that sweep is work the event should have delivered.
        timed-out,
        /// The provider has no interrupt surface on this configuration (e.g. the
        /// board's eo9:platform answers `unsupported` in v1): the caller owns its
        /// sweep pacing — the polled fallback.
        unsupported,
    }

    /// One root-hub port's status (OHCI: HcRhPortStatus decoded).
    record port-status {
        /// A device is connected (CCS).
        connected: bool,
        /// The port is enabled (PES).
        enabled: bool,
        /// The port is powered (PPS).
        powered: bool,
        /// The connected device is low-speed (LSDA).
        low-speed: bool,
        /// Connect status changed since last cleared (CSC).
        connect-change: bool,
    }

    /// An attached (reset + addressed) device on one root-hub port.
    resource device;
    /// An opened endpoint on an attached device: interrupt-IN (`open-interrupt-in`,
    /// read with `read`) or bulk (`open-bulk-in`/`open-bulk-out`, moved with
    /// `bulk-read`/`bulk-write`). Operations of the wrong shape for the endpoint's
    /// kind answer `unsupported`.
    resource endpoint;

    /// Bring up the controller if needed (claiming it through the underlying
    /// capability on first use — the D41 bring-up-claim discipline) and describe it.
    controller: async func(u: borrow<usb-impl>) -> result<controller-info, usb-error>;

    /// One port's current status. Ports are numbered from 1, as in the OHCI register
    /// file.
    port: async func(u: borrow<usb-impl>, port: u8) -> result<port-status, usb-error>;

    /// Park until the root hub signals a connect-status change (OHCI RHSC), where the
    /// controller's interrupt is routed; the wait is bounded by the provider (the
    /// SPEC's awaits-are-bounded rule), so `timed-out` is an ordinary answer — call
    /// again after re-sweeping `port`. Where no interrupt surface exists the call
    /// returns `unsupported` immediately and the caller paces its own sweeps (the
    /// capability-gated polled fallback — the board's v1 shape).
    watch-ports: async func(u: borrow<usb-impl>) -> result<watch-outcome, usb-error>;

    /// Reset the port (OHCI 1.0a port-reset timing), assign the device an address, and
    /// size endpoint 0 from the descriptor head. The returned device is ready for
    /// control transfers; the full descriptor chain is the consumer's to read.
    attach: async func(u: borrow<usb-impl>, port: u8) -> result<device, usb-error>;

    /// Traverse ONE hub level to the single device behind it (the demo-scope hub
    /// mini-driver): when `d` enumerated as a hub (class 09), configure it, power
    /// its downstream ports, hub-reset the one connected full-speed child, and
    /// enumerate it like any device. Refuses typed (`unsupported`, with the
    /// limitation named in `io`'s text where finer) on a non-hub device, multiple
    /// connected children, more than one hub level, or a low-speed child.
    attach-child: async func(d: borrow<device>) -> result<device, usb-error>;

    /// A control transfer with an IN data stage: returns the data the device sent
    /// (possibly shorter than `length` — USB short reads are normal).
    control-in: async func(
        d: borrow<device>,
        request-type: u8,
        request: u8,
        value: u16,
        index: u16,
        length: u16,
    ) -> result<list<u8>, usb-error>;

    /// A control transfer with no data stage (`data` empty) or an OUT data stage.
    control-out: async func(
        d: borrow<device>,
        request-type: u8,
        request: u8,
        value: u16,
        index: u16,
        data: list<u8>,
    ) -> result<_, usb-error>;

    /// Open an interrupt-IN endpoint (number, max packet size, and polling interval
    /// come from the device's configuration descriptor, which the consumer parsed).
    open-interrupt-in: async func(
        d: borrow<device>,
        endpoint: u8,
        max-packet: u16,
        interval-ms: u8,
    ) -> result<endpoint, usb-error>;

    /// Open a bulk-IN endpoint (number and max packet size come from the device's
    /// configuration descriptor, which the consumer parsed). The data toggle starts
    /// at DATA0 — open after SET_CONFIGURATION (USB 2.0 §9.4.5) — and lives in the
    /// provider for the endpoint's lifetime. Re-opening the same direction resets
    /// the toggle to DATA0.
    open-bulk-in: async func(
        d: borrow<device>,
        endpoint: u8,
        max-packet: u16,
    ) -> result<endpoint, usb-error>;

    /// Open a bulk-OUT endpoint. Same contract as `open-bulk-in`.
    open-bulk-out: async func(
        d: borrow<device>,
        endpoint: u8,
        max-packet: u16,
    ) -> result<endpoint, usb-error>;

    /// Read up to `length` bytes from a bulk-IN endpoint. Short reads are normal
    /// (the device terminates a bulk transfer with a short or zero-length packet —
    /// same contract as `read`); the provider may also answer fewer bytes than
    /// `length` per call (its transfer-window grain) — loop until the protocol
    /// layer's expected count is in.
    ///
    /// A `stall` answer is the device halting the endpoint (BOT error signalling):
    /// the provider has already recovered ITS half (the halted schedule entry is
    /// cleared and the host-side toggle reset to DATA0); the consumer must issue
    /// CLEAR_FEATURE(ENDPOINT_HALT) via `control-out` — which resets the DEVICE's
    /// toggle to DATA0 (USB 2.0 §9.4.5) — before the next transfer on this endpoint.
    bulk-read: async func(e: borrow<endpoint>, length: u32) -> result<list<u8>, usb-error>;

    /// Write `data` to a bulk-OUT endpoint (the provider loops over its
    /// transfer-window grain internally; the call returns once every byte is
    /// accepted). Empty `data` sends one zero-length packet. `stall` carries the
    /// same halt-recovery contract as `bulk-read`.
    bulk-write: async func(e: borrow<endpoint>, data: list<u8>) -> result<_, usb-error>;

    /// Whether reads on this endpoint are event-driven: `true` means `read` parks on
    /// the controller's interrupt (the consumer drops its poll pacing and just calls
    /// `read` again on an empty answer); `false` means reads are short polls and the
    /// consumer owns the pacing (the capability-gated fallback where the underlying
    /// device capability routes no interrupts — drivers hold no time capability, so
    /// the pacing has to live with the consumer). Bulk transfers complete within the
    /// call either way (their completions ride the same done-queue writeback; the
    /// flag matters to `read` pacing only).
    event-driven: func(e: borrow<endpoint>) -> bool;

    /// The next report on the endpoint. Where the controller's interrupt is routed
    /// (`event-driven` answers true), this parks until the endpoint's done-queue
    /// writeback (OHCI WDH) or the provider's bounded wait window expires — an empty
    /// list then just means "call again". Where no interrupt surface exists it is a
    /// short poll: an empty list means nothing arrived and the consumer owns the wait
    /// policy (the same "empty result = nothing waiting" contract as eo9:net's
    /// recv-frame).
    read: async func(e: borrow<endpoint>) -> result<list<u8>, usb-error>;
}

/// Optional flavor of `usb` (hand-written for v0; see SPEC: The capability algebra).
interface usb-optional {
    use types.{usb-impl};

    /// `none` when the capability was not granted.
    default: func() -> option<usb-impl>;
}

/// Compose-time configuration entry for usb.deny.
interface deny-config {
    use types.{usb-impl};
    configure: func() -> result<usb-impl, string>;
}

/// usb.none — absence: exports the optional flavor answering `none`.
world none {
    export types;
    export usb-optional;
}

/// usb.deny — refusal: exports `usb` with every operation failing with `denied`.
world deny {
    export types;
    export usb;
    export deny-config;
}
