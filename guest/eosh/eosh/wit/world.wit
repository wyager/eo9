// eosh — the Eo9 shell, itself an ordinary Eo9 program (SPEC.md, "Shell").
//
// The shell has no private powers: composing is the unprivileged component algebra,
// and running is the Compile + Task capabilities it was granted like any other
// executor. Program names resolve through the filesystem for now (`/bin/<name>.wasm`,
// opened for execution); the store-backed resolution of area 11 replaces that
// convention without touching this world.
package eo9-eosh:eosh@0.1.0;

/// The interactive shell: reads command lines from standard input, composes and runs
/// them, and prints each program's outcome as WAVE. With `--command` it executes that
/// single command line and exits (the one-shot form used by scripts and tests).
///
///   eosh
///   eosh --command "net.none $ browser --url https://example.com"
world eosh {
    import eo9:exec/component-algebra@0.1.0;
    import eo9:exec/compile@0.1.0;
    import eo9:exec/task@0.1.0;
    import eo9:text/text@0.1.0;
    import eo9:fs/fs@0.1.0;
    // The svc capability (background services). The shell imports both the optional
    // flavors (to observe whether this session was granted them — most sessions are
    // not) and the full interfaces (to call them when it was). Executors register the
    // operations unconditionally; calling one without the grant traps, which the shell
    // never does because it checks the optional first.
    import eo9:svc/detach@0.1.0;
    import eo9:svc/detach-optional@0.1.0;
    import eo9:svc/services@0.1.0;
    import eo9:svc/services-optional@0.1.0;

    variant program-success {
        /// The session ended cleanly (end of input, `exit`, or a one-shot command that
        /// completed successfully).
        exited,
        /// The user asked to halt the machine (`poweroff`). The intent flows up the
        /// supervision tree as a typed outcome: init exits when its console reports
        /// it (instead of restarting the console per ruling D), and the embedder —
        /// the kernel, or the eo9 process — then powers off / ends. A shell run
        /// without init treats it like exit: the session ends.
        poweroff-requested,
    }

    variant program-failure {
        /// Reading from or writing to the text streams failed.
        io(string),
        /// One-shot mode only: the program ran and reported failure in its own
        /// vocabulary (the rendered outcome).
        command-failed(string),
        /// One-shot mode only: the program ended abnormally — it trapped (the rendered
        /// reason).
        command-trapped(string),
        /// One-shot mode only: the program ended abnormally — it was killed before
        /// producing an outcome (the rendered reason).
        command-killed(string),
        /// One-shot mode only: the command never ran — it did not parse, resolve,
        /// compose, compile, or spawn (the rendered error). Distinct from
        /// `command-failed` so an embedder can tell "the command failed" apart from
        /// "the shell could not run the command".
        not-runnable(string),
    }

    export main: async func(command: option<string>) -> result<program-success, program-failure>;
}
