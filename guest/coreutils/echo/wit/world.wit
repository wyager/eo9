// echo — write text to stdout. Capability: eo9:text only (a minimal-capability tool).
package eo9-coreutils:echo@0.1.0;
world echo {
    import eo9:text/text@0.1.0;
    variant program-success {
        done,
    }
    variant program-failure {
        io(string),
    }
    /// The words to print, joined by single spaces (the variadic tail: `echo hello world`).
    /// The named-flag spelling `echo --text hi` still binds the one-element list.
    export main: func(text: list<string>) -> result<program-success, program-failure>;
}
