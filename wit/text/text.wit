/// eo9:text — standard text streams (std{in,out,err}).
///
/// See SPEC.md: "Text API", "The capability algebra".
package eo9:text@0.1.0;

/// Root-handle type, shared by the required and `-optional` flavors.
///
/// The root resource lives in its own types-only interface (rather than inside
/// `text` as the spec sketches) so that importing `text-optional` — or exporting
/// it from the `none` stub — does not implicitly import the full required `text`
/// interface. See plan/02-wit.md Decisions.
interface types {
    /// The text capability's root handle.
    resource text-impl;
}

/// The console surface: write a line out or to the error stream, read a line in.
interface text {
    use types.{text-impl};

    /// The capability's root handle (see SPEC: The capability algebra).
    default: func() -> text-impl;

    variant text-error {
        /// The stream is closed (e.g. output was detached, or stdin hit end of input).
        closed,
        /// The operation is not supported by this transport (today: `read-key` on a
        /// line-only stream — piped stdin, net.text's NVT, a service's captured text).
        /// A typed refusal, so a consumer can fall back to `read-line` instead of
        /// guessing from an io string.
        unsupported,
        io(string),
    }

    /// Which output stream to write to.
    enum output-stream {
        out,
        err,
    }

    /// One decoded keystroke (the payload of `read-key`). Transports own their wire
    /// decoding — escape sequences, telnet negotiation, termios — and hand the consumer
    /// semantics, so eosh's editor is transport-independent:
    ///
    /// * `char` is one byte of printable input (>= 0x20, not 0x7f). Multi-byte UTF-8
    ///   characters arrive as their individual bytes, in order.
    /// * `ctrl` carries the raw control byte (1..=26 are Ctrl-A..Ctrl-Z; e.g.
    ///   `ctrl(3)` is Ctrl-C, `ctrl(4)` is Ctrl-D). Enter/backspace/tab have their own
    ///   cases and are never reported as `ctrl`.
    /// * `eof` is an explicit end-of-input keystroke on transports that decode one;
    ///   transport end-of-input (the stream closing) is `read-key`'s `none` answer,
    ///   mirroring `read-line`.
    variant key {
        %char(u8),
        enter,
        backspace,
        tab,
        up,
        down,
        left,
        right,
        ctrl(u8),
        eof,
    }

    /// Write UTF-8 text to stdout or stderr.
    write: func(t: borrow<text-impl>, to: output-stream, text: string) -> result<_, text-error>;

    /// Read one line from stdin (without the trailing newline); `none` at end of input.
    read-line: async func(t: borrow<text-impl>) -> result<option<string>, text-error>;

    /// Read one decoded keystroke from stdin; `none` at end of input. The per-key
    /// surface behind eosh's incremental editor (docs/study/incremental-repl-for-eosh.md
    /// M2). **The provider must not echo** — the consumer owns the line image.
    ///
    /// Transports that cannot deliver single keystrokes (line-buffered pipes, net.text's
    /// line-based NVT, captured service streams) answer `err(unsupported)`, and the
    /// consumer falls back to `read-line`; a session is expected to probe once and stick
    /// with the answer.
    read-key: async func(t: borrow<text-impl>) -> result<option<key>, text-error>;
}

/// Optional flavor of `text` (hand-written for v0; see SPEC: The capability algebra).
interface text-optional {
    use types.{text-impl};

    /// `none` when the capability was not granted.
    default: func() -> option<text-impl>;
}

/// Compose-time configuration entry for text.null: `configure` returns the root handle
/// that the exported `text` serves via `default()` (see SPEC: Binary or provider, never both).
interface null-config {
    use types.{text-impl};
    configure: func() -> result<text-impl, string>;
}

/// Compose-time configuration entry for text.capture (same convention as `null-config`).
interface capture-config {
    use types.{text-impl};
    configure: func() -> result<text-impl, string>;
}

/// Compose-time configuration entry for net.text — the socket-backed text provider
/// (`net.virtio $ net.l4.over-l2 $ net.text $ eosh`: the shell over the network).
/// `configure` binds the TCP port the provider listens on; unconfigured, the provider
/// keeps its documented default, port 23, so plain composition works and never traps.
///
/// **SECURITY: net.text speaks cleartext, unauthenticated telnet-style NVT.** Whoever
/// can reach the port owns the composed session — it is a trusted-LAN/dev tool only
/// (the QEMU slirp-hostfwd bring-up path), never an exposure surface. An authenticated,
/// encrypted transport (SSH) is explicitly deferred by the owner.
///
/// The stub's world is crate-local (`eo9:net-text/net-text` — imports `eo9:net/l4`,
/// exports `types`, `text`, and this entry), following the `net.l4.over-l2` precedent
/// for cross-package middleware.
interface net-text-config {
    use types.{text-impl};
    configure: func(port: u16) -> result<text-impl, string>;
}

/// text.none — absence: exports the optional flavor answering `none`.
world none {
    export types;
    export text-optional;
}

/// text.null — accept and discard all output; stdin is permanently at end of input.
world null {
    export types;
    export text;
    export null-config;
}

/// text.capture — buffer output for later retrieval.
/// TODO: forward over the Message API (eo9:message) once that package exists.
world capture {
    export types;
    export text;
    export capture-config;
}
